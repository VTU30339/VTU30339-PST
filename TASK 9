import java.util.Scanner;

interface LastDigitSum {
    int add(int a, int b);
}

public class LastDigitMethodReference {

    public static int sumLastDigits(int a, int b) {
        return (a % 10) + (b % 10);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = sc.nextInt();

        System.out.print("Enter second number: ");
        int b = sc.nextInt();

        LastDigitSum obj = LastDigitMethodReference::sumLastDigits;

        System.out.println("Sum of Last Digits = " + obj.add(a, b));

        sc.close();
    }
}

OUTPUT:
Enter first number: 10
Enter second number: 20
Sum of Last Digits = 0
